<?xml version="1.0"?>
<package format="2">
  <!-- 独立包：RAPTOR 只作为参考实现，不作为运行依赖。 -->
  <name>raptor_dynamics_sampler</name>
  <version>0.1.0</version>
  <description>Standalone Python sampler for RAPTOR-style quadrotor dynamics parameter JSON files.</description>

  <maintainer email="user@example.com">xin</maintainer>
  <license>MIT</license>

  <!-- 最小 catkin 元数据，方便该包放在 ROS/catkin 的 src 工作空间中。 -->
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>python3</exec_depend>

  <export>
  </export>
</package>
